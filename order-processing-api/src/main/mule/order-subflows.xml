<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:vm="http://www.mulesoft.org/schema/mule/vm"
      xmlns:java="http://www.mulesoft.org/schema/mule/java"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
          http://www.mulesoft.org/schema/mule/core  http://www.mulesoft.org/schema/mule/core/current/mule.xsd
          http://www.mulesoft.org/schema/mule/http  http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
          http://www.mulesoft.org/schema/mule/vm    http://www.mulesoft.org/schema/mule/vm/current/mule-vm.xsd
          http://www.mulesoft.org/schema/mule/java  http://www.mulesoft.org/schema/mule/java/current/mule-java.xsd">

    <flow name="update-order-impl-flow" doc:name="Update Order Implementation">
        <set-variable variableName="correlationId"
                      value="#[attributes.headers['X-Correlation-ID'] default uuid()]"/>
        <set-variable variableName="orderId"     value="#[attributes.uriParams.orderId]"/>
        <set-variable variableName="newStatus"   value="#[payload.status]"/>
        <set-variable variableName="updateNotes" value="#[payload.notes default null]"/>

        <java:invoke-static class="com.mulesoft.interview.OrderRepository"
                            method="findById(String)" target="currentOrder">
            <java:args>#[{ orderId: vars.orderId }]</java:args>
        </java:invoke-static>
        <choice doc:name="Order Exists?">
            <when expression="#[vars.currentOrder == null]">
                <raise-error type="APP:NOT_FOUND" description="#['Order not found: ' ++ vars.orderId]"/>
            </when>
            <otherwise>
                <logger level="DEBUG" message="[UPDATE] Order found: #[vars.orderId]"/>
            </otherwise>
        </choice>

        <java:invoke-static class="com.mulesoft.interview.OrderValidator"
                            method="isValidStatusTransition(String, String)" target="transitionValid">
            <java:args>#[{ currentStatus: vars.currentOrder.status, newStatus: vars.newStatus }]</java:args>
        </java:invoke-static>
        <choice doc:name="Transition Valid?">
            <when expression="#[vars.transitionValid == false]">
                <raise-error type="APP:CONFLICT"
                             description="#['Invalid transition: ' ++ vars.currentOrder.status ++ ' -> ' ++ vars.newStatus]"/>
            </when>
            <otherwise>
                <logger level="DEBUG" message="[UPDATE] Transition valid: #[vars.currentOrder.status] -> #[vars.newStatus]"/>
            </otherwise>
        </choice>

        <java:invoke-static class="com.mulesoft.interview.OrderUtils"
                            method="buildAuditEntry(String, String, String)" target="updateAudit">
            <java:args>#[{ orderId: vars.orderId, action: 'UPDATE_STATUS:' ++ vars.newStatus, performedBy: (attributes.headers['X-User-ID'] default 'api-client') }]</java:args>
        </java:invoke-static>

        <set-variable variableName="updatedOrder"
                      value="#[%dw 2.0 output application/java var ex = vars.currentOrder ---
ex ++ {
    status:     vars.newStatus,
    notes:      (vars.updateNotes default ex.notes),
    updatedAt:  now() as String { format: &quot;yyyy-MM-dd'T'HH:mm:ssZ&quot; },
    auditTrail: (ex.auditTrail default []) ++ [ vars.updateAudit ]
}]"/>

        <java:invoke-static class="com.mulesoft.interview.OrderRepository"
                            method="save(String, Map)" target="saved">
            <java:args>#[{ orderId: vars.orderId, order: vars.updatedOrder }]</java:args>
        </java:invoke-static>

        <set-payload mimeType="application/json"
                     value="#[%dw 2.0 output application/json var o = vars.updatedOrder ---
{ orderId: o.orderId, status: o.status, priority: o.priority, totalAmount: o.totalAmount,
  updatedAt: o.updatedAt, correlationId: vars.correlationId,
  auditEntries: sizeOf(o.auditTrail default []),
  links: { self: '/api/v1/orders/' ++ o.orderId } }]"/>

        <logger level="INFO" message='[UPDATE] #[vars.orderId] -> #[vars.newStatus]'/>
        <error-handler ref="global-error-handler"/>
    </flow>

    <flow name="delete-order-impl-flow" doc:name="Delete Order Implementation">
        <set-variable variableName="correlationId"
                      value="#[attributes.headers['X-Correlation-ID'] default uuid()]"/>
        <set-variable variableName="orderId" value="#[attributes.uriParams.orderId]"/>

        <java:invoke-static class="com.mulesoft.interview.OrderRepository"
                            method="exists(String)" target="orderExists">
            <java:args>#[{ orderId: vars.orderId }]</java:args>
        </java:invoke-static>
        <choice doc:name="Order Exists for Delete?">
            <when expression="#[vars.orderExists == false]">
                <raise-error type="APP:NOT_FOUND" description="#['Order not found: ' ++ vars.orderId]"/>
            </when>
            <otherwise>
                <logger level="DEBUG" message="[DELETE] Order confirmed for deletion: #[vars.orderId]"/>
            </otherwise>
        </choice>

        <java:invoke-static class="com.mulesoft.interview.OrderRepository"
                            method="delete(String)" target="deleted">
            <java:args>#[{ orderId: vars.orderId }]</java:args>
        </java:invoke-static>

        <set-payload value="#[null]"/>
        <logger level="INFO" message='[DELETE] #[vars.orderId] removed=#[vars.deleted]'/>
        <error-handler ref="global-error-handler"/>
    </flow>

    <flow name="order-stats-impl-flow" doc:name="Order Statistics Implementation">
        <java:invoke-static class="com.mulesoft.interview.OrderRepository"
                            method="findAll()" target="allOrders"/>

        <java:invoke-static class="com.mulesoft.interview.OrderUtils"
                            method="calculateOrderMetrics(List)" target="metrics">
            <java:args>#[{ orders: vars.allOrders default [] }]</java:args>
        </java:invoke-static>

        <set-payload mimeType="application/json"
                     value="#[%dw 2.0 output application/json var m = vars.metrics ---
{ summary: { totalOrders: m.totalOrders, totalRevenue: m.totalRevenue,
             avgOrderValue: m.avgOrderValue, generatedAt: m.generatedAt },
  byStatus: m.byStatus,
  links: { orders: '/api/v1/orders', health: '/api/v1/health' } }]"/>

        <logger level="INFO" message='[STATS] total=#[vars.metrics.totalOrders] revenue=#[vars.metrics.totalRevenue]'/>
        <error-handler ref="global-error-handler"/>
    </flow>

    <sub-flow name="customer-enrichment-subflow" doc:name="Customer Enrichment Subflow">
        <http:request config-ref="jsonplaceholder-request-config"
                      method="GET" path="/{customerId}" responseTimeout="10000">
            <http:uri-params>#[{ customerId: (vars.originalRequest.customerId default '1') }]</http:uri-params>
        </http:request>
        <set-payload mimeType="application/json"
                     value="#[%dw 2.0 output application/json ---
{ id: payload.id, name: payload.name, email: payload.email,
  phone: (payload.phone default 'N/A'),
  company: (payload.company.name default null),
  address: { street: (payload.address.street default null),
             city:   (payload.address.city   default null) },
  enriched: true }]"/>
        <logger level="DEBUG" message='[ENRICH] Customer #[payload.id] (#[payload.name])'/>
    </sub-flow>

    <flow name="order-notification-consumer-flow" doc:name="Order Notification Consumer">
        <vm:listener config-ref="order-notifications-vm-config"
                     queueName="${order.notification.queue-name}"
                     numberOfConsumers="2">
            <redelivery-policy maxRedeliveryCount="3" useSecureHash="true"/>
        </vm:listener>

        <logger level="INFO"
                message='[NOTIFY] event=#[payload.event] orderId=#[payload.orderId] lane=#[payload.lane]'/>

        <choice doc:name="Route by Priority">
            <when expression="#[payload.priority == 'PRIORITY']">
                <logger level="INFO" message='[NOTIFY] PRIORITY #[payload.orderId] - VIP'/>
            </when>
            <when expression="#[payload.priority == 'EXPRESS']">
                <logger level="INFO" message='[NOTIFY] EXPRESS #[payload.orderId]'/>
            </when>
            <otherwise>
                <logger level="DEBUG" message='[NOTIFY] STANDARD #[payload.orderId]'/>
            </otherwise>
        </choice>

        <error-handler>
            <on-error-continue type="MULE:REDELIVERY_EXHAUSTED">
                <logger level="ERROR" message='[DLQ] #[payload.orderId] failed 3 retries: #[error.description]'/>
            </on-error-continue>
            <on-error-continue type="ANY">
                <logger level="ERROR" message='[NOTIFY] Error: #[error.description]'/>
            </on-error-continue>
        </error-handler>
    </flow>

</mule>