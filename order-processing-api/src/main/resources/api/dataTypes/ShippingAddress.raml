#%RAML 1.0 DataType
displayName: ShippingAddress
description: Delivery address for an order.

type: object
properties:
  street:
    type: string
    description: Street address including house/building number
    example: "123 Main Street"
  city:
    type: string
    description: City or town
    example: "New York"
  country:
    type: string
    description: ISO 3166-1 alpha-2 country code or full country name
    example: "US"
  zipCode:
    type: string
    required: false
    description: Postal or ZIP code
    example: "10001"

example:
  street: "123 Main Street"
  city: "New York"
  country: "US"
  zipCode: "10001"