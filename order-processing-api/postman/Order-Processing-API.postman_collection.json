  "item": [
    {
      "name": "Health Check",
      "item": [
        {
          "name": "GET /health — Application Status",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has status UP', function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql('UP');",
                  "});",
                  "",
                  "pm.test('Application name is correct', function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.app).to.eql('Order Processing API');",
                  "});",
                  "",
                  "pm.test('Timestamp is present', function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.timestamp).to.be.a('string');",
                  "    pm.expect(json.timestamp.length).to.be.greaterThan(0);",
                  "});",
                  "",
                  "pm.test('Endpoints catalog is present', function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.endpoints).to.be.an('object');",
                  "    pm.expect(json.endpoints.createOrder).to.include('/api/v1/orders');",
                  "});",
                  "",
                  "console.log('Health check passed — API is UP');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Verifies the application is running. Returns status UP with endpoint catalog."
          }
        }
      ]
    },
    {
      "name": "Orders — Create",
      "item": [
        {
          "name": "POST /orders — Create STANDARD Order ($50)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function() {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Response has orderId', function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.orderId).to.be.a('string');",
                  "    pm.expect(json.orderId).to.include('ORD-');",
                  "    pm.collectionVariables.set('orderId', json.orderId);",
                  "    console.log('Saved orderId: ' + json.orderId);",
                  "});",
                  "",
                  "pm.test('Status is PENDING', function() {",
                  "    pm.expect(pm.response.json().status).to.eql('PENDING');",
                  "});",
                  "",
                  "pm.test('Priority is STANDARD (amount < $1,000)', function() {",
                  "    pm.expect(pm.response.json().priority).to.eql('STANDARD');",
                  "});",
                  "",
                  "pm.test('Processing lane is STANDARD_LANE', function() {",
                  "    pm.expect(pm.response.json().processingLane).to.eql('STANDARD_LANE');",
                  "});",
                  "",
                  "pm.test('Total amount is 50.0', function() {",
                  "    pm.expect(pm.response.json().totalAmount).to.eql(50.0);",
                  "});",
                  "",
                  "pm.test('Item count is 1', function() {",
                  "    pm.expect(pm.response.json().itemCount).to.eql(1);",
                  "});",
                  "",
                  "pm.test('Customer name enriched from JSONPlaceholder', function() {",
                  "    var customerName = pm.response.json().customerName;",
                  "    pm.expect(customerName).to.be.a('string');",
                  "    pm.expect(customerName.length).to.be.greaterThan(0);",
                  "});",
                  "",
                  "pm.test('HATEOAS links present', function() {",
                  "    var links = pm.response.json().links;",
                  "    pm.expect(links).to.have.property('self');",
                  "    pm.expect(links.self).to.include('/api/v1/orders/');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Correlation-ID", "value": "postman-std-001" },
              { "key": "X-User-ID", "value": "postman-tester" }
