    {
      "name": "Orders — Update (State Machine)",
      "item": [
        {
          "name": "PUT /orders/:orderId — PENDING → CONFIRMED",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Status updated to CONFIRMED', function() {",
                  "    pm.expect(pm.response.json().status).to.eql('CONFIRMED');",
                  "});",
                  "",
                  "pm.test('Audit trail has 2 entries (CREATE + UPDATE)', function() {",
                  "    pm.expect(pm.response.json().auditEntries).to.eql(2);",
                  "});",
                  "",
                  "pm.test('Updated timestamp is present', function() {",
                  "    pm.expect(pm.response.json().updatedAt).to.be.a('string');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-ID", "value": "billing-team" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"CONFIRMED\",\n  \"notes\": \"Payment received and verified\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{orderId}}"]
            },
            "description": "Advances order from PENDING to CONFIRMED. Valid state-machine transition."
          }
        },
        {
          "name": "PUT /orders/:orderId — CONFIRMED → PROCESSING",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Status updated to PROCESSING', function() {",
                  "    pm.expect(pm.response.json().status).to.eql('PROCESSING');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"PROCESSING\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{orderId}}"]
            },
            "description": "Advances order from CONFIRMED to PROCESSING."
          }
        },
        {
          "name": "PUT /orders/:orderId — PROCESSING → SHIPPED",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Status updated to SHIPPED', function() {",
                  "    pm.expect(pm.response.json().status).to.eql('SHIPPED');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"SHIPPED\",\n  \"notes\": \"Dispatched via courier XYZ — tracking #TR123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{orderId}}"]
            },
            "description": "Advances order from PROCESSING to SHIPPED."
          }
        },
        {
          "name": "PUT /orders/:orderId — 409 Invalid Transition (SHIPPED → PENDING)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 409 Conflict', function() {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "",
                  "pm.test('Error code is CONFLICT', function() {",
                  "    pm.expect(pm.response.json().error.code).to.eql('CONFLICT');",
                  "});",
                  "",
                  "pm.test('Error message shows invalid transition', function() {",
                  "    pm.expect(pm.response.json().error.message).to.include('SHIPPED');",
                  "    pm.expect(pm.response.json().error.message).to.include('PENDING');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"PENDING\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{orderId}}"]
            },
            "description": "Tests state machine enforcement: SHIPPED → PENDING is not allowed and should return 409 Conflict."
          }
        },
        {
          "name": "PUT /orders/:orderId — SHIPPED → DELIVERED",
          "event": [
            {
              "listen": "test",
              "script": {
