            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"1\",\n  \"items\": [\n    {\n      \"productId\": \"PROD-101\",\n      \"name\": \"Widget Pro\",\n      \"quantity\": 2,\n      \"unitPrice\": 25.00\n    }\n  ],\n  \"totalAmount\": 50.00,\n  \"shippingAddress\": {\n    \"street\": \"123 Main Street\",\n    \"city\": \"New York\",\n    \"country\": \"US\",\n    \"zipCode\": \"10001\"\n  },\n  \"notes\": \"Standard order — created via Postman\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": ["{{baseUrl}}"],
              "path": ["orders"]
            },
            "description": "Creates a STANDARD priority order ($50). The orderId is automatically saved to the {{orderId}} collection variable for use in subsequent requests."
          }
